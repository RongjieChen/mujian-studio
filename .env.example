# Bind locally; use an SSH tunnel to access a remote Spark.
HOST=127.0.0.1
PORT=4317
DATA_DIR=./data
LLM_BASE_URL=http://127.0.0.1:8088/v1
LLM_MODEL=mujian-director
LLM_API_KEY=local
LLM_CONTEXT=32768
LLM_MAX_TOKENS=12000
# Set true for a thinking-only model such as Qwen3-Next-80B-A3B-Thinking.
LLM_REASONING=false
# Optional memory guard for llama.cpp started with --sleep-idle-seconds 30.
LLM_WAIT_FOR_SLEEP=false
LLAMA_ADMIN_URL=http://127.0.0.1:8088
GPU_EXCLUSIVE=false
# With vLLM sleep mode, bind the model server to loopback before enabling its
# development control endpoints. The worker is unloaded before each wake-up.
GPU_BACKEND=llamacpp
LLM_ADMIN_URL=http://127.0.0.1:8000
# Optional Pi template compatibility for Qwen models served by vLLM.
LLM_THINKING_FORMAT=
# Additional trusted hostnames or exact development origins; empty in deployment.
APP_ALLOWED_HOSTS=
APP_ALLOWED_ORIGINS=
# Optional StepFun configuration. Set LLM_PROVIDER=stepfun to select it.
LLM_PROVIDER=local
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/v1
STEPFUN_MODEL=step-3.7-flash
# The media worker runs on the same Spark, on loopback.
MEDIA_WORKER_URL=http://127.0.0.1:4318
