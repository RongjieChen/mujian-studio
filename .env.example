# Bind locally; use an SSH tunnel to access a remote Spark.
HOST=127.0.0.1
PORT=4317
DATA_DIR=./data
LLM_BASE_URL=http://127.0.0.1:8088/v1
LLM_MODEL=mujian-director
LLM_API_KEY=local
LLM_CONTEXT=32768
LLM_MAX_TOKENS=12000
# Optional StepFun configuration. Set LLM_PROVIDER=stepfun to select it.
LLM_PROVIDER=local
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/v1
STEPFUN_MODEL=step-3.7-flash
# The media worker runs on the same Spark, on loopback.
MEDIA_WORKER_URL=http://127.0.0.1:4318
